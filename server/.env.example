# Port the Node process listens on. Nginx/Caddy terminates TLS in front of it.
PORT=8080
HOST=0.0.0.0

# Identity of this node. Shown in the app as the selected test server.
SERVER_ID=lhr
SERVER_NAME=London, UK
SERVER_COUNTRY=GB
SERVER_SPONSOR=Tom

# Largest single /download response, in bytes. The client never needs more than
# a few hundred MB per stream; this is only a guard against someone pointing a
# script at the box and asking for a terabyte.
MAX_DOWNLOAD_BYTES=1073741824

# Largest single /upload body, in bytes. Bodies are drained, never buffered,
# so this is a fairness limit rather than a memory limit.
MAX_UPLOAD_BYTES=268435456

# Set to 1 when the process sits behind Nginx/ALB/Cloudflare so the real client
# IP is read from X-Forwarded-For instead of the proxy's socket address.
TRUST_PROXY=1

# Comma-separated origins allowed to call the endpoints, or * for any.
# A React Native app sends no Origin header, so * costs you nothing there; it
# only matters if you also run a web client.
ALLOWED_ORIGINS=*

# Let /info enrich the caller's IP with ISP/ASN/city from ipwho.is, cached in
# memory. Set to 0 to keep the server fully offline.
GEO_LOOKUP=1

# Other nodes in the fleet, advertised by /servers so the app can pick the
# closest one without shipping a new build. JSON array.
# PEERS=[{"id":"khi","name":"Karachi, PK","country":"PK","url":"https://khi.speed.example.com"}]
