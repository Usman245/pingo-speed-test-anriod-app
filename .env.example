# Public seed URLs for the speed-test fleet. The app fetches /servers from a
# seed, races all returned nodes, and uses the lowest-latency reachable server.
# Add one or more public HTTPS endpoints, separated by commas.
EXPO_PUBLIC_SPEEDTEST_SEED_URLS=https://isb.speed.example.com,https://khi.speed.example.com

# Optional Supabase values used by the existing account/history feature.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
